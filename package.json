{
  "name": "glade",
  "version": "0.2.2",
  "description": "A local media gallery for your folders",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "npm run build && cargo run --release --",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check web/icons.mjs && node --check web/app.mjs && node --check web/playback.mjs",
    "build": "vite build",
    "dev": "node scripts/dev.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mantine/core": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@videojs/react": "^10.3.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.68.0",
    "markdown-it": "^15.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-photo-album": "^3.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "6.4.3"
  }
}

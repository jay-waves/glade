{
  "name": "glade",
  "version": "0.1.4",
  "description": "A local media gallery for your folders",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "npm run build && cargo run --release --",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check web/icons.mjs && node --check web/app.mjs && node --check web/playback.mjs",
    "build": "vite build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@primer/react": "^38.40.0",
    "@primer/primitives": "^11.10.0",
    "@primer/octicons-react": "^19.38.0",
    "react-photo-album": "^3.6.2"
  },
  "devDependencies": {
    "vite": "6.4.3",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "typescript": "^7.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
